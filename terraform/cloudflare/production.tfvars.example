# Production tfvars — copy to production.tfvars and fill in real values.
# NEVER commit real secrets to source control; use:
#   terraform apply -var-file=production.tfvars

# A31/A35: Least-privilege Cloudflare API tokens.
# Create separate tokens in the Cloudflare Dashboard:
#   My Profile → API Tokens → Create Token → Custom token
#
# Required token permissions:
#   dns_api_token        — Zone:Read + DNS:Edit
#   waf_api_token        — Zone:Read + WAF:Edit + Zone Settings:Edit
#   logpush_api_token    — Account:Read + Logs:Edit
#   workers_deploy_token — Account:Read + Cloudflare Workers:Edit
#   r2_lifecycle_token   — Account:Read + R2:Edit

dns_api_token         = ""
waf_api_token         = ""
logpush_api_token     = ""
workers_deploy_token  = ""
r2_lifecycle_token    = ""
cloudflare_account_id = ""  # Your Cloudflare account ID
zone_id               = ""  # Zone ID for the production domain

# ── Worker origin hostname ─────────────────────────────────────────────
# A31: Must be a real, approved hostname. The placeholder
# affilite-mix-origin.invalid is rejected by Terraform validation.
worker_origin_hostname = "origin.your-domain.com"

# ── A42: Billing & queue alerts ────────────────────────────────────────
billing_alert_threshold_usd   = 100   # Daily spend alert threshold
queue_backlog_alert_threshold = 1000  # Queue depth alert threshold

# ── FIX-01: Alerts & Logpush ──────────────────────────────────────────
# Set alerts_enabled = true after provisioning at least one notification
# destination below. Create destinations in the Cloudflare Dashboard:
#   Dashboard → Notifications → Destinations → Add
# Then paste the destination IDs here.

alerts_enabled = true

alert_mechanisms = {
  email     = []           # e.g. [{ id = "abc123" }]
  pagerduty = []           # e.g. [{ id = "def456" }]
  webhooks  = []           # e.g. [{ id = "ghi789" }]  (Slack webhook, etc.)
}

# Logpush — ship Workers trace events to R2 for long-term retention.
# 1. Apply storage.tf so cloudflare_r2_bucket.worker_logs exists.
# 2. Mint R2 API token scoped to that bucket.
# 3. Fill in the r2:// URL below, then set logpush_enabled = true.

logpush_enabled       = true
logpush_destination_conf = ""  # e.g. "r2://<account-id>/workers-logpush?account-id=...&access-key-id=...&secret-access-key=..."

# ── A210: Email security (SPF / DKIM / DMARC) ─────────────────────────
# These DNS records prevent domain spoofing in phishing attacks.
# Adjust the SPF record to include your actual mail senders.
dns_records = {
  "spf-wristnerd" = {
    name    = "wristnerd.xyz"
    type    = "TXT"
    content = "v=spf1 include:_spf.google.com include:amazonses.com ~all"
    # A39: proxied MUST be false — SPF/DMARC/DKIM TXT records must be
    # DNS-visible to receiving MTAs. Proxying hides them and breaks email auth.
    # The dns_records variable now defaults proxied=true, so this is required.
    proxied = false
    comment = "A210/A39: SPF - authorize legitimate mail senders. DNS-only (unproxied) by design."
  }
  "dmarc-wristnerd" = {
    name    = "_dmarc.wristnerd.xyz"
    type    = "TXT"
    content = "v=DMARC1; p=reject; rua=mailto:dmarc-reports@wristnerd.xyz; ruf=mailto:dmarc-forensics@wristnerd.xyz; adkim=s; aspf=s; pct=100"
    # A39: proxied MUST be false — DMARC TXT records must be DNS-visible.
    proxied = false
    comment = "A210/A39: DMARC - reject unauthenticated mail, strict alignment. DNS-only (unproxied) by design."
  }
  # DKIM is typically configured by the mail provider (Resend, Google Workspace,
  # etc.) which provides the specific selector and public key. Add a record like:
  # "dkim-resend" = {
  #   name    = "resend._domainkey.wristnerd.xyz"
  #   type    = "TXT"
  #   content = "v=DKIM1; k=rsa; p=<public-key-from-resend>"
  #   comment = "A210: DKIM - Resend mail signing key"
  # }
}

# ── WAF configuration ─────────────────────────────────────────────────
# Source from Cloudflare analytics → Security → Events → top ASNs.
waf_blocked_asns      = []
waf_blocked_countries = ["KP", "IR", "SY"]

# A36: Enable managed WAF rulesets (default: Cloudflare Managed + OWASP).
# Uncomment to customise; empty list disables managed rules.
# waf_managed_rulesets = [
#   { ruleset_id = "efb7b8c949ac4650a09736fc376e9aee" },  # Cloudflare Managed Ruleset
#   { ruleset_id = "4814384a9e5d4991b9815dcfc25d2f1f" },  # Cloudflare OWASP Core Ruleset
# ]

# ── R2 location hint ──────────────────────────────────────────────────
r2_default_location   = "WNAM"
worker_logs_bucket_name = "workers-logpush"

# A37: R2 hardening settings.
# WARNING: r2_worm_enabled = true applies WORM (Write Once Read Many) /
# Object Lock to the worker_logs bucket. Once enabled, objects become
# IMMUTABLE for the retention period and CANNOT be deleted or overwritten.
# This prevents log tampering but also prevents log rotation and may
# increase storage costs. Understand the compliance implications before enabling.
# Only disable if your organization's log retention policy explicitly permits it.
r2_worm_enabled       = true
r2_replication_enabled = false  # Enable once R2 replication GA is available
