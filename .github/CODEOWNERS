# BLIND SPOT FIX: Ownership and Review Enforcement
# This file, combined with GitHub Branch Protection rules, ensures
# that changes to critical infrastructure and security boundaries
# require explicit approval from the security and platform teams.

# Default owner for everything not explicitly defined
*       @groupsmix/engineering

# Core platform and Edge infrastructure
/middleware.ts          @groupsmix/platform
/workers/               @groupsmix/platform
/open-next.config.ts    @groupsmix/platform
/wrangler.jsonc         @groupsmix/platform

# Security boundaries
/lib/auth.ts            @groupsmix/security
/lib/authz.ts           @groupsmix/security
/lib/ssrf-guard.ts      @groupsmix/security
/lib/csp.ts             @groupsmix/security
/lib/rate-limit.ts      @groupsmix/security

# Privileged Supabase gateway and its allow-list of importers.
# Touching these files (or adding a new caller via the allow-list) MUST
# go through @groupsmix/security review — service-role access bypasses
# RLS and is the most direct path to a cross-tenant breach.
/lib/server-only/                       @groupsmix/security
/lib/security/service-role-allowlist.ts @groupsmix/security

# Multi-tenant CSRF/exemption registry — every exempt route is its own
# security boundary, so additions/changes to the registry route through
# the security team.
/lib/security/csrf-exempt-registry.ts   @groupsmix/security

# Database and migrations (Data Plane)
/supabase/migrations/   @groupsmix/data-platform
/lib/dal/               @groupsmix/data-platform

# Infrastructure as Code
/terraform/             @groupsmix/platform @groupsmix/security
/.github/workflows/     @groupsmix/platform
# C2: deploy.yml is the single path to production (~1,500 lines);
# changes require both platform and security review.
/.github/workflows/deploy.yml @groupsmix/platform @groupsmix/security
