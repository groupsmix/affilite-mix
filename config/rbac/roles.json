      "_sod_note": "super_admin intentionally has no 'approve_deploy' or 'approve_payout' to satisfy SoD requirements. Deployments must be approved by a second human via GitHub PR review."
    }
  ],
  "sod_forbidden_pairs": [
    {
      "write_action": "approve_deploy",
      "approval_action": "write",
      "_note": "No role may both initiate and approve a deployment."
    },
    {
      "write_action": "approve_payout",
      "approval_action": "write",
      "_note": "No role may both initiate and approve a payout."
    }
  ]
