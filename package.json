{
  "name": "affilite-mix",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit --project tsconfig.worker.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:worker",
    "knip": "knip --no-progress",
    "lint:worker": "eslint workers/custom-worker.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "test": "cross-env NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "lighthouse": "lhci autorun",
    "add-site": "tsx scripts/add-site.ts",
    "check:site-drift": "tsx scripts/check-site-config-drift.ts",
    "verify:backup-order": "tsx scripts/backup-restore-order.ts",
    "audit:password-hashes": "tsx scripts/audit-password-hashes.ts",
    "pause-site": "tsx scripts/pause-site.ts",
    "redesign-site": "tsx scripts/redesign-site.ts",
    "drain-dlq": "tsx scripts/drain-dlq.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:ai-compared": "tsx scripts/seed-ai-compared.ts",
    "seed:crypto-tax-au": "tsx scripts/seed-crypto-tax-au.ts",
    "setup-supabase-auth": "tsx scripts/setup-supabase-auth.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test:chaos": "vitest run __tests__/chaos",
    "test:mutation": "stryker run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@sentry/browser": "^10.59.0",
    "@sentry/cloudflare": "^10.59.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/extension-youtube": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "bcryptjs": "~3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "domhandler": "^6.0.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "htmlparser2": "^12.0.0",
    "jose": "~6.2.3",
    "lucide-react": "^1.21.0",
    "next": "~15.5.18",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.1",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "vanilla-cookieconsent": "^3.1.0",
    "wasm-image-optimization": "^2.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/eslintrc": "^3.3.5",
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.61.0",
    "@size-limit/preset-app": "^12.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@supabase/postgrest-js": "^2.106.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.14",
    "fast-check": "4.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.10",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.4",
    "server-only": "^0.0.1",
    "size-limit": "^12.1.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "tmp": "^0.2.7",
    "uuid": "^14.0.0",
    "fast-xml-parser": "^5.7.0",
    "undici": "^7.0.0",
    "esbuild": "^0.28.1",
    "ws": "^8.21.0",
    "qs": "^6.15.2",
    "sharp": "^0.35.3",
    "@lhci/cli": {
      "js-yaml": "^3.15.0"
    }
  }
}
