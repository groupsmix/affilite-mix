# ── Required ─ Supabase ──────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL must always be the Supabase REST API URL
# (https://<project-ref>.supabase.co). Do NOT use a pooler URL here —
# pooler URLs (aws-0-<region>.pooler.supabase.com) are PostgreSQL
# connection strings used by psql / the deploy workflow for migrations,
# not by the JS client. Mixing these up causes obscure 5xx errors
# because the JS client tries to speak HTTP/REST to a Postgres socket.
# See SUPABASE_DB_POOLER_URL further down for the migration pooler URL.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Required ─ Auth ──────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-byte-hex-string

# F-AUTH-03: JWT key rotation. When set, JWT_SECRET_CURRENT is preferred
# over JWT_SECRET for signing/verifying new tokens. To rotate keys without
# logging users out, leave the old value in JWT_SECRET (still accepted by
# verifiers) and set the new value here. Once all in-flight tokens have
# expired, promote JWT_SECRET_CURRENT to JWT_SECRET and unset this var.
JWT_SECRET_CURRENT=

# audit-cleanup FR-C7-ENV-01 / S1-A3.E1: previous JWT secret kept ONLY
# during a key rotation window so existing tokens stay verifiable.
# `instrumentation.ts` and `lib/jwt-secret.ts` consume this. The value
# MUST be removed within 24h of rotation completing — leaving it
# permanently widens the verification key set and defeats the rotation.
JWT_SECRET_PREVIOUS=

# AUD-09: ISO-8601 timestamp of when the JWT key rotation began.
# Required when JWT_SECRET_PREVIOUS is set. The app refuses to start
# in production if JWT_SECRET_PREVIOUS has been set for more than 24h.
# Example: JWT_ROTATION_STARTED_AT=2026-05-28T12:00:00Z
JWT_ROTATION_STARTED_AT=

# P0-1 / SEC-CRIT-04 / SEC-02 (etap-3): Admin session hardening flags.
# `ADMIN_SESSION_STRICT=true` is the umbrella that turns on all three
# defences below. Each one can also be toggled individually for incident
# response (e.g. KV outage → disable token revocation only).
# Recognised values per flag (parsed via `lib/env-bool.ts`, case-insensitive):
#   truthy:  "1", "true", "yes", "on"
#   falsy:   "0", "false", "no", "off", ""
# Unset / empty means "follow the umbrella ADMIN_SESSION_STRICT value".
ADMIN_SESSION_STRICT=
# Per-control overrides (SEC-CRIT-04). Leave unset to inherit the umbrella.
# NOTE (deep-audit B3): ADMIN_SESSION_TOKEN_REVOCATION_STRICT is tri-state and
# does NOT inherit fail-closed from the umbrella. Production MUST set it to
# "true" (fail-closed on KV outage). "false" disables revocation entirely and
# is break-glass only — see docs/runbooks/kv-outage.md.
ADMIN_SESSION_TOKEN_REVOCATION_STRICT=
ADMIN_SESSION_BINDING_STRICT=
ADMIN_SESSION_IDLE_STRICT=

# Audit R-006: signed by lib/supabase-server.ts/getAuthenticatedClient so
# Supabase RLS evaluates the request as a tenant-scoped user. Required
# in production; without it tenant-authenticated DB calls fall through
# to anonymous access (and most admin reads will 500). Get this value
# from Supabase Dashboard → Project Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=change-me-to-the-supabase-project-jwt-secret

# ── Required (production) ─ Internal API ─────────────────
# Shared secret for internal service-to-service communication (middleware ↔ resolve-site)
INTERNAL_API_TOKEN=change-me-to-a-random-64-byte-hex-string

# F-003: Migration toggle for internal HMAC request authentication.
# Receivers (queue consumers, internal cron routes) verify HMAC headers
# (timestamp + nonce + signature). During rollout, set this to a non-empty
# value (e.g. "warn" or "compat") so receivers also accept the legacy
# Bearer INTERNAL_API_TOKEN. Unset (or set to "strict") to require HMAC
# only. See lib/internal-hmac.ts.
# CR-01: MUST be 'strict' in production. Disables legacy Bearer fallback
# for internal endpoints so a leaked token cannot forge queue ingestion.
INTERNAL_HMAC_MIGRATION_MODE=strict

# ── Required (production) ─ Cron jobs ────────────────────
# Shared fallback secret used when a per-trigger secret below is unset.
# Kept as a transitional default so existing /api/health checks and
# legacy cron routes keep working while per-trigger secrets roll out.
CRON_SECRET=change-me-to-a-random-string

# ── Optional ─ Per-trigger cron secrets (B-3) ────────────
# Rotate or revoke a single trigger without touching the others by
# setting a dedicated secret here. Each route accepts the matching
# per-trigger secret first and falls back to CRON_SECRET above.
#
# This list is the documentation half of the cron registry in
# `lib/cron-registry.ts` — adding a new cron job there should be
# accompanied by adding its env var here. The
# `__tests__/cron-registry.test.ts` suite asserts these stay in sync.
#
#   Route                          Env var                    Schedule
#   ------------------------------ -------------------------- ------------
#   /api/cron/publish              CRON_PUBLISH_SECRET        */5 * * * *
#   /api/cron/stripe-sync          CRON_STRIPE_SYNC_SECRET    0 1 * * *
#   /api/cron/ai-generate          CRON_AI_SECRET             0 2 * * *
#   /api/cron/sitemap-refresh      CRON_SITEMAP_SECRET        0 3 * * *
#   /api/cron/data-retention       CRON_RETENTION_SECRET      0 4 * * *
#   /api/cron/commission-ingest    CRON_COMMISSION_SECRET     0 5 * * *
#   /api/cron/epc-recompute        CRON_EPC_SECRET            0 6 * * *
#   /api/cron/price-scrape         CRON_PRICE_SECRET          0 7 * * *
#   /api/cron/expire-deals         CRON_DEALS_SECRET          0 * * * *
#   /api/cron/click-reconcile      CRON_CLICK_RECONCILE_SECRET */15 * * * *
#   /api/cron/access-review        CRON_ACCESS_REVIEW_SECRET  0 8 * * 1
#   /api/cron/homepage-synthetic-check CRON_HOMEPAGE_SYNTHETIC_SECRET */10 * * * *
CRON_PUBLISH_SECRET=
CRON_STRIPE_SYNC_SECRET=
CRON_AI_SECRET=
CRON_SITEMAP_SECRET=
CRON_RETENTION_SECRET=
CRON_COMMISSION_SECRET=
CRON_EPC_SECRET=
CRON_PRICE_SECRET=
CRON_DEALS_SECRET=
CRON_CLICK_RECONCILE_SECRET=
CRON_ACCESS_REVIEW_SECRET=
CRON_HOMEPAGE_SYNTHETIC_SECRET=

# F-006 escape hatch. In production, routes that pass a per-trigger secret
# (e.g. CRON_PUBLISH_SECRET) reject requests authed via the shared
# CRON_SECRET — one shared secret across every cron job is too much
# privilege in a single token. Set this to "1" only as a temporary
# rollout aid; leave unset in steady-state production.
CRON_ALLOW_SHARED_FALLBACK_IN_PROD=

# audit-cleanup FR-C7-ENV-01 / M-8: dedicated bearer secret for
# `/api/health` detailed responses so health probes (uptime monitors,
# K8s readiness checks) do not share credentials with cron triggers.
# When unset, /api/health falls back to CRON_SECRET for backward
# compatibility but emits only a minimal "healthy" payload to
# unauthenticated callers. Consumed at `app/api/health/route.ts:33`.
HEALTH_DETAIL_BEARER=

# ── Optional ─ Edge runtime tuning ───────────────────────
# F-017: ceiling on self-referential Worker subrequests (via the
# WORKER_SELF_REFERENCE service binding, used for OpenNext cache hops).
# middleware.ts rejects with 508 once the x-worker-recursion-depth header
# reaches this value. Default is 2 (tightened from the historical 3); the
# legitimate cache chain is a single hop. Raise only if a future OpenNext
# change needs a deeper legitimate chain. Clamped to 1..10; invalid values
# fall back to the default. Consumed at lib/worker-recursion.ts.
MAX_WORKER_RECURSION_DEPTH=

# ── Required (production) ─ Cron host ────────────────────
# Canonical base URL the scheduled Worker POSTs cron jobs to.
# Set this to your primary site domain (e.g. https://wristnerd.xyz).
# Without this the Worker will log an error and skip all scheduled jobs.
CRON_HOST=https://your-primary-domain.example.com

# ── Required (production) ─ Canonical app URL ────────────
# Used for constructing absolute URLs (e.g. password reset links).
# Must be the canonical base URL of your primary site.
APP_URL=https://your-primary-domain.example.com

# ── Optional (CI/deploy) ─ Database connection URLs ──────
# SUPABASE_DB_POOLER_URL — IPv4-reachable session pooler URL for CI/deploy
# migrations. GitHub Actions runners are IPv4-only; the direct DB host
# (db.<ref>.supabase.co) may be IPv6-only on the free tier. If set, the
# deploy workflow uses this in preference to SUPABASE_DB_URL.
# Find it in Supabase Dashboard → Project Settings → Database →
# Connection pooling → Session mode.
SUPABASE_DB_POOLER_URL=

# STAGING_SUPABASE_DB_URL — separate staging database for the deploy
# workflow's clean-reset smoke test. Must NOT equal SUPABASE_DB_URL.
# When set, the deploy workflow drops the public schema, replays every
# migration from zero, and verifies the schema before touching production.
STAGING_SUPABASE_DB_URL=

# ── Required (production) ─ TOTP Encryption (B-01) ───────
# AES-256-GCM envelope encryption key for TOTP shared secrets at rest.
# Any string works (HKDF-derived internally). Generate with:
#   openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ── Required (production) ─ Click Cache HMAC (CF-03) ─────
# Dedicated HMAC key for click-cache integrity. Using a separate key
# from INTERNAL_API_TOKEN means rotating the API token does not cause
# a cache stampede on Supabase.
CLICK_CACHE_HMAC_KEY=

# ── Optional ─ Email (Resend) ────────────────────────────
# Required in production when NEWSLETTER_ENABLED=1 (N-01).
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=

# ── Optional ─ Image storage (Cloudflare R2, S3-API) ─────
# Used by lib/r2.ts to generate presigned upload URLs.
# The browser uploads directly to R2 — no Worker binding needed.
# In production, set these as runtime secrets via `wrangler secret put`.
# See docs/cloudflare-r2-images.md for full setup guide.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Optional ─ CAPTCHA (Cloudflare Turnstile) ────────────
# P1-5: Set ENABLE_TURNSTILE=true to require Turnstile verification on
# login and other protected forms. When enabled, TURNSTILE_SECRET_KEY
# and NEXT_PUBLIC_TURNSTILE_SITE_KEY are REQUIRED in production.
# When not enabled (default), Turnstile verification is skipped entirely.
ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# F-005 escape hatch. In production Turnstile is ON by default (RISK-16 in
# lib/turnstile.ts). Explicitly setting ENABLE_TURNSTILE=false in production
# removes bot protection from /admin/login and other protected forms, so the
# app refuses to start unless you acknowledge that trade-off here. Leave unset
# in normal production; set to "1" only if you deliberately run without
# Turnstile (e.g. you front the app with another bot-management layer).
ALLOW_TURNSTILE_DISABLED_IN_PROD=

# ── Optional ─ Paid memberships (Stripe) ─────────────────
# Required when membership checkout + webhook are enabled.
# Without these set, POST /api/membership/checkout and
# POST /api/membership/webhook both return 503.
# STRIPE_WEBHOOK_SECRET must match the signing secret of the
# endpoint configured in the Stripe Dashboard (starts with `whsec_`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs — two supported formats. Either format works; the
# JSON map takes precedence when both are set so a new tier can be
# rolled out without redeploying.
#
# audit5-#39 / Preferred — JSON map (one env var, scales to N tiers):
#   STRIPE_PRICE_MAP={"insider":"price_xxx","pro":"price_yyy"}
# Keys are lower-cased on read and must appear in ALLOWED_TIERS
# (app/api/membership/checkout/route.ts). Unknown tiers are ignored.
STRIPE_PRICE_MAP=
# Legacy per-tier vars (still honoured when STRIPE_PRICE_MAP is unset):
STRIPE_PRICE_ID_INSIDER=
STRIPE_PRICE_ID_PRO=
# STRIPE_REVERSE_RECONCILE_ENABLED — opt-in to the reverse reconciliation pass
# in /api/cron/stripe-sync (Issue 4). When "true", the cron walks every
# DB-active membership with a stripe_subscription_id and deactivates any whose
# Stripe subscription is in a terminal state (canceled / incomplete_expired).
# DEFAULT: false. Enable deliberately: the pass makes one Stripe API call per
# active member per cron tick (billable volume), and a misconfigured
# cancellation rule could mass-deactivate members. Never deactivate without a
# confirmed Stripe response — a retrieve failure skips the row.
STRIPE_REVERSE_RECONCILE_ENABLED=false

# ── Required (production) ─ Error Monitoring (Sentry) ────
SENTRY_DSN=
# Client-side Sentry DSN (enables browser error reporting via sentry.client.config.ts)
NEXT_PUBLIC_SENTRY_DSN=

# ── Optional ─ Cloudflare API (cache purge, deploy) ──────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ── Cloudflare bindings (set via wrangler.jsonc / Cloudflare dashboard) ──
# RATE_LIMIT_KV — KV namespace for distributed rate limiting.
# Not a traditional env var; bind in wrangler.jsonc under [kv_namespaces].
# Required in production — without it, rate-limited routes reject all requests.
# See lib/rate-limit.ts for setup instructions.

# ── Optional ─ AI Content Engine ────────────────────────
# Fallback chain: Cloudflare AI → Gemini → Groq → Cohere
# A provider is used only when BOTH its credentials are present AND its
# AI_ENABLE_* flag is explicitly set to "true" (or "1"). Just having the
# API key is not enough — this lets you temporarily disable a provider
# without unsetting its key.
CLOUDFLARE_AI_API_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
AI_ENABLE_CLOUDFLARE=false
AI_ENABLE_GEMINI=false
AI_ENABLE_GROQ=false
AI_ENABLE_COHERE=false

# LIVE-18: per-call hard ceiling on user-supplied AI prompts (in chars,
# not tokens). Defaults to 16000 (~4k tokens) which keeps every provider
# inside its default max_tokens budget. Override only if your provider
# contract supports a larger context window. Non-positive / non-numeric
# values fall back to the default. See lib/ai/prompt-sanitization.ts.
AI_MAX_PROMPT_CHARS=

# ── Optional ─ Per-tenant cost & quota ceilings (G-42) ───
# Global default ceilings applied to every tenant. Site-level
# overrides live in `config/sites/<site>.ts:quotas`. Unset = unlimited.
# See `docs/per-tenant-quotas.md` for the resource taxonomy.
QUOTA_DEFAULT_AI_TOKENS_PER_MONTH=
QUOTA_DEFAULT_AI_COST_MICRO_USD_PER_MONTH=
QUOTA_DEFAULT_AI_REQUESTS_PER_DAY=
QUOTA_DEFAULT_R2_STORAGE_BYTES=
QUOTA_DEFAULT_R2_EGRESS_BYTES_PER_MONTH=

# ── Optional ─ Affiliate Networks ──────────────────────
CJ_API_KEY=
CJ_PUBLISHER_ID=
PARTNERSTACK_API_KEY=
ADMITAD_API_KEY=
ADMITAD_PUBLISHER_ID=

# ── Optional ─ Google Search Console auto-submit ─────
# OAuth 2.0 access token with `https://www.googleapis.com/auth/webmasters`
# scope. Used by the daily sitemap-refresh cron to submit each active
# site's sitemap. Leave unset to skip submission.
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
# Property type: `url_prefix` (default, e.g. https://example.com/) or `domain` (sc-domain:example.com)
GOOGLE_SEARCH_CONSOLE_PROPERTY_TYPE=url_prefix

# ── Optional ─ Affiliate URL allow-list (F-010) ──────────
# Comma-separated list of additional merchant domains permitted in the
# affiliate_url column on top of the hardcoded network defaults in
# lib/affiliate-domain-allowlist.ts. Use this to onboard merchants that
# aren't covered by the built-in CJ/Impact/ShareASale/etc. list.
# Example: AFFILIATE_ALLOWED_DOMAINS=acme.com,partner.example.com
AFFILIATE_ALLOWED_DOMAINS=

# Enforcement mode for the allow-list above:
#   warn   (default) — log violations, allow the write through. Use this
#                       while auditing existing data.
#   strict           — reject writes whose domain is not on the allow-list.
#   MUST be 'strict' in production (R-01).
AFFILIATE_DOMAIN_ENFORCEMENT=strict

# ── Optional ─ Outbound fetch allow-list (F-022) ─────────
# Comma-separated list of additional hostnames the centralised
# fetchAllowed() helper may call. Merged on top of the hardcoded list
# of internal + SaaS hostnames in lib/fetch-allowed.ts. Wildcards of
# the form *.example.com match any subdomain. Used to mitigate SSRF
# and supply-chain attacks on outbound HTTP.
# Example: OUTBOUND_ALLOWED_HOSTNAMES=api.partner.com,*.cdn.example.com
OUTBOUND_ALLOWED_HOSTNAMES=

# ── Optional ─ Privacy / GDPR (F-PRIVACY) ────────────────
# Dedicated HMAC-SHA256 key used to hash user emails in GDPR
# export/erasure audit logs. Falls back to JWT_SECRET when unset, but
# you should set this in production so rotating JWT_SECRET does not
# break correlation across historical privacy audit entries.
GDPR_HASH_SECRET=

# ── Optional ─ Rate limiting kill-switches (F-3 / F-015) ──
# Incident-response kill-switch: when set to "true", every rate-limited
# request is rejected immediately without consulting KV/DO. Use during
# active abuse to shed load instantly; unset to restore normal limits.
RATE_LIMIT_FORCE_CLOSED=

# Grace window (in milliseconds) during which the limiter falls back to
# per-isolate memory when the RATE_LIMIT_KV namespace is unavailable.
# After the window elapses without recovery the limiter fails closed.
# Defaults to 60000 (60s); raise only for ops drills.
RATE_LIMIT_KV_GRACE_MS=

# ── Optional ─ Observability (OpenTelemetry, log shipping) ─
# OTEL_ENDPOINT — OTLP/HTTP collector endpoint for distributed tracing.
# Wrangler interpolates this into wrangler.jsonc's `otel.endpoint`.
# When set in production, OTEL_AUTH_TOKEN MUST also be configured
# (lib/server-env.ts validateObservabilityEnv() enforces this).
# Configure your sink (Honeycomb, Datadog, Grafana Tempo, …) and store
# the token as a CI / Worker secret.
OTEL_ENDPOINT=
OTEL_AUTH_TOKEN=

# LOG_SHIPPER_ENABLED — set as a GitHub Actions repo *variable* (Settings
# → Secrets and variables → Actions → Variables, NOT Secrets). When
# "true", the deploy workflow creates the affilite-mix-logs R2 bucket,
# deploys the log-shipper Tail Worker, and rewrites tail_consumers in
# wrangler.jsonc via scripts/inject-tail-consumers.mjs. Leave unset (or
# "false") to deploy without log shipping. See docs/pre-launch.md.
LOG_SHIPPER_ENABLED=

# ── Optional ─ Operational flags (P1-2) ──────────────────
# APP_MAINTENANCE_MODE — set to "1" or "true" to take the entire app
# offline (503 on all routes except /api/health and /api/csp-report).
# Also supports a KV flag for hot-toggling without redeploy.
# WARNING: this blocks ALL traffic including admin. Use for planned
# maintenance windows only.
APP_MAINTENANCE_MODE=

# ALLOW_LOCALHOST_FALLBACK_IN_PROD — set to "1" to skip the
# unknown-host rate limit and DB hostname lookup for localhost in
# production-mode local runs (e.g. Lighthouse CI with `next start`).
# WARNING: NEVER set this in actual production deployments. It exists
# solely for CI environments that run NODE_ENV=production locally.
ALLOW_LOCALHOST_FALLBACK_IN_PROD=

# ── Optional ─ Multi-site development ────────────────────
# Controls which site localhost resolves to (e.g. watch-tools, crypto-tools, ai-compared).
# Set this to suppress [site-context] Build-time fallback warnings during local builds.
NEXT_PUBLIC_DEFAULT_SITE=ai-compared

# ── Required (multi-tenant) ─ Wildcard domain routing ───
# Comma-separated list of parent domains whose subdomains are resolved via DB.
# Defaults to "wristnerd.xyz" if not set.
# Comma-separated list of parent domains that support wildcard subdomain routing.
# Must match the domains listed in wrangler.jsonc routes and terraform worker_custom_domains.
# Example: WILDCARD_PARENT_DOMAINS=wristnerd.xyz,groupsmix.com
WILDCARD_PARENT_DOMAINS=wristnerd.xyz


# ── Optional ─ Trust proxy headers ───────────────────────
# Set to 'true' if deployed behind a proxy like Cloudflare to trust
# X-Forwarded-For / CF-Connecting-IP headers when resolving client IPs.
TRUST_PROXY_HEADERS=true

# ── Optional ─ Trust cf-connecting-ip (F8) ───────────────
# `cf-connecting-ip` is only trustworthy when the origin is reachable
# EXCLUSIVELY through Cloudflare (CF sets it and strips client copies).
# Defaults to NOT trusted ('false') so a directly-reachable origin
# (e.g. a *.workers.dev URL, or an origin not firewalled to Cloudflare
# IP ranges) cannot have its source IP spoofed via this header (which
# would poison rate-limit buckets / JWT IP binding). Set to 'true' ONLY
# when the origin is locked to Cloudflare. See docs/CLOUDFLARE.md.
TRUST_CF_CONNECTING_IP=true

# ── Optional ─ AI configuration ──────────────────────────
# AI_ALLOWED_LINK_DOMAINS — comma-separated list of domains allowed in AI-generated content links.
AI_ALLOWED_LINK_DOMAINS=
# AI_GLOBAL_DAILY_CEILING_USD — maximum daily AI spend across all tenants (default: 50).
AI_GLOBAL_DAILY_CEILING_USD=50

# ── Optional ─ Security tuning ───────────────────────────
# BCRYPT_ROUNDS — bcrypt cost factor for password hashing (default: 12).
BCRYPT_ROUNDS=12
# TOTP_ENCRYPTION_KEY_V2 — AES-256 key for encrypting TOTP secrets at rest (required for 2FA).
TOTP_ENCRYPTION_KEY_V2=
# INTERNAL_HMAC_MIGRATION_DEADLINE — ISO date after which legacy unsigned internal API calls are rejected.
INTERNAL_HMAC_MIGRATION_DEADLINE=
# REVALIDATE_ALL_SITES_TOKEN — bearer token for the /api/revalidate-all-sites endpoint.
REVALIDATE_ALL_SITES_TOKEN=
# ADMIN_ACTIVITY_TIMEOUT_MINS — admin idle session timeout in minutes (default: 30, clamped to 5–60).
ADMIN_ACTIVITY_TIMEOUT_MINS=
# SECURITY_ALERT_EMAIL — destination email for suspicious-login alerts (falls back to the user's email).
SECURITY_ALERT_EMAIL=

# ── Optional ─ Rate limiting / resilience ────────────────
# RATE_LIMIT_FORCE_OPEN — set to "true" to disable rate limiting globally (emergency use only).
RATE_LIMIT_FORCE_OPEN=
# LOGIN_RATE_LIMIT_GLOBAL_DISABLED — set to "true" to disable global login rate limiting (testing only).
LOGIN_RATE_LIMIT_GLOBAL_DISABLED=
# HIBP_CACHE_TTL_SECONDS — TTL (in seconds) for HIBP prefix→suffix list cached
# in APP_CACHE_KV (P1-4 / P1-6). Default: 86400 (24h). Max: 604800 (7d).
HIBP_CACHE_TTL_SECONDS=
# LOG_LEVEL — logging verbosity: debug, info, warn, error (default: info).
LOG_LEVEL=info
# LOG_SAMPLE_RATE — probability (0.0–1.0) that a log entry is emitted.
# Defaults to 1.0 (all logs). Lower in high-traffic production to reduce volume.
LOG_SAMPLE_RATE=
# RATE_LIMIT_MEMORY_MAX_ENTRIES — max entries in the per-isolate in-memory
# rate-limit map. Clamped to 1 000–100 000. Default: 10 000.
RATE_LIMIT_MEMORY_MAX_ENTRIES=
# KV_DEDUP_WRITE_ALERT_RATE — threshold (requests/min) above which the click
# tracker alerts on KV dedup-write volume. Default: 500.
KV_DEDUP_WRITE_ALERT_RATE=

# ── Optional ─ UI / environment label ─────────────────────
# NEXT_PUBLIC_APP_ENV_NAME — label shown on the admin login page
# (e.g. "STAGING", "DEV"). Omit in production.
NEXT_PUBLIC_APP_ENV_NAME=

# ── Optional ─ R2 bucket names ───────────────────────────
# Override the default R2 bucket names (typically set in wrangler.jsonc bindings).
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=

# ── Optional ─ E2E testing ────────────────────────────────
# E2E_BASE_URL — base URL for Playwright E2E tests (e.g. https://preview.example.com).
# Required when running `npm run test:e2e`. Playwright throws if unset.
E2E_BASE_URL=

# ── Optional ─ Preview / staging ─────────────────────────
# PREVIEW_HOST_ALLOWLIST — comma-separated list of preview hostnames to allow.
PREVIEW_HOST_ALLOWLIST=
# PREVIEW_WORKER_NAME — custom worker name for preview deployments (used by scripts/generate-preview-wrangler.cjs).
PREVIEW_WORKER_NAME=
# DATABASE_URL — direct Postgres connection string (used by scripts and migrations only, not runtime).
DATABASE_URL=
# SITE_URL — canonical site URL for generating absolute URLs in scripts.
SITE_URL=
# REQUIRE_STAGING_DB — set to "true" to require STAGING_SUPABASE_DB_URL in CI (enforces db-audit.sh on protected branches).
