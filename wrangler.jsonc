// Wrangler config for @opennextjs/cloudflare Workers deployment.
// Deploy via: npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "affilite-mix",
  "main": "workers/custom-worker.ts",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // A206/A209: Disable the *.workers.dev preview URL so all traffic must
  // transit the zone-level WAF, Bot Fight Mode, and TLS settings.
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "affilite-mix",
    },
  ],
  // KV namespace for distributed rate limiting.
  //
  // The `id` is intentionally NOT hardcoded to a specific Cloudflare
  // account's namespace.  Each deployment environment must provision
  // its own namespace and supply the ID via the
  // RATE_LIMIT_KV_NAMESPACE_ID environment variable at build/deploy
  // time.  Wrangler interpolates `${VAR}` in string fields from the
  // shell environment when running `wrangler deploy` /
  // `opennextjs-cloudflare deploy`.
  //
  // One-time setup per environment:
  //   1. npx wrangler kv:namespace create RATE_LIMIT_KV
  //   2. export RATE_LIMIT_KV_NAMESPACE_ID="<id from step 1>"
  //   3. deploy as usual
  //
  // See docs/CLOUDFLARE.md for the full bootstrap procedure.
  // R-12: KV namespace IDs are injected at deploy time via environment
  // variables. Do not hardcode environment-specific IDs here.
  // Set RATE_LIMIT_KV_NAMESPACE_ID and APP_CACHE_KV_NAMESPACE_ID in your
  // deploy environment, then use `scripts/inject-kv-ids.mjs` or pass
  // them via wrangler CLI overrides.
  "kv_namespaces": [
    {
      // Env var: RATE_LIMIT_KV_NAMESPACE_ID
      // Guard: scripts/check-wrangler-placeholders.mjs
      "binding": "RATE_LIMIT_KV",
      "id": "${RATE_LIMIT_KV_NAMESPACE_ID}",
    },
    {
      // Env var: APP_CACHE_KV_NAMESPACE_ID
      // Guard: scripts/check-wrangler-placeholders.mjs
      "binding": "APP_CACHE_KV",
      "id": "${APP_CACHE_KV_NAMESPACE_ID}",
    },
  ],
  // R2 incremental cache — create the bucket in the Cloudflare dashboard first
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "next-inc-cache",
    },
  ],
  // Durable Objects for OpenNext's caching layer and F-005 rate limiting.
  // These classes are re-exported from workers/custom-worker.ts so wrangler
  // must declare the bindings and the initial SQLite-backed migration, even
  // if tag-based revalidation is not yet enabled in open-next.config.ts.
  // See: https://opennext.js.org/cloudflare/caching
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
      {
        // F-005: atomic distributed rate limiting.
        // lib/rate-limit.ts prefers this binding over KV when present.
        "name": "RATE_LIMITER_DO",
        "class_name": "RateLimiterDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RateLimiterDO"],
    },
  ],
  // F-028 / A44: Cloudflare Queue for affiliate click tracking.
  //
  // DELIVERY SEMANTICS:
  //   * At-least-once delivery: each message is delivered to the
  //     consumer at least once. Consumers MUST be idempotent — use
  //     the message ID (msg.id) as an idempotency key.
  //   * Ordering: messages within a single producer are generally
  //     FIFO but ordering is not guaranteed across retries or after
  //     a visibility timeout. Do not rely on strict ordering.
  //   * Replay: use the Cloudflare Dashboard or API to replay
  //     messages from the dead-letter queue to the main queue.
  //     See: https://developers.cloudflare.com/queues/reference/apis/
  //   * Poison-message triage: after max_retries (3), the message
  //     is moved to the DLQ. Monitor DLQ depth with the
  //     click_tracking_dlq_depth alert (terraform/cloudflare/alerts.tf).
  //     Runbook: docs/runbooks/dlq-overflow.md
  //
  // A44: ENCRYPTION POSTURE:
  //   * Queue data is encrypted at rest by Cloudflare using AES-256
  //     (platform-managed keys). No customer-managed key option
  //     is currently available.
  //   * Data in transit is encrypted via TLS 1.3 between producer
  //     → queue → consumer (all within Cloudflare's network).
  //   * Message bodies should NOT contain PII. If click data
  //     includes personal data, hash/encrypt it before publishing.
  //
  // The click endpoint (/api/track/click) publishes lightweight messages to
  // this queue instead of writing directly to Supabase. The consumer runs
  // the batch insert with retry/backoff and a dead-letter queue for failed
  // batches, so a Supabase outage no longer drops click data on the floor.
  //
  // One-time setup per environment (CI/production):
  //   npx wrangler queues create click-tracking
  //   npx wrangler queues create click-tracking-dlq
  //
  // The queue is consumed by the worker exported from workers/custom-worker.ts
  // (see the `queue` handler) which forwards batches to /api/queue/clicks.
  "queues": {
    "producers": [
      {
        "binding": "CLICK_QUEUE",
        "queue": "click-tracking",
      },
    ],
    "consumers": [
      {
        "queue": "click-tracking",
        // A42/A44: Batch settings tuned for throughput + latency balance.
        // max_batch_size=25 and max_batch_timeout=5s give ~5 req/s
        // throughput. Adjust if queue depth backlog alerts fire.
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        // S9-H2: Limit concurrent batch processing to prevent Supabase
        // connection pool exhaustion under high volume.
        "max_concurrency": 2,
        "dead_letter_queue": "click-tracking-dlq",
      },
    ],
  },
  // ═════════════════════════════════════════════════════════════════
  // DOMAIN ROUTING - Dashboard Managed
  // ═════════════════════════════════════════════════════════════════
  //
  // ADD/REMOVE DOMAINS WITHOUT CODE CHANGES:
  // 1. Go to Cloudflare Dashboard → Workers & Pages → affilite-mix
  // 2. Settings → Triggers → Add Custom Domain
  // 3. Enter your domain (e.g., "cryptoranked.xyz" or "crypto.wristnerd.xyz")
  // 4. Set DNS record (A or CNAME) pointing to the worker
  // 5. Update the domain in your Supabase sites table
  //
  // ROUTES EXPLAINED:
  // - "*.wristnerd.xyz" catches ALL subdomains (arabictools, crypto, etc.)
  // - Add standalone domains (cryptoranked.xyz) via Dashboard → Custom Domains
  // - The middleware resolves domain → site_id via DB lookup
  //
  "routes": [
    // ── Custom Domains (auto-provision DNS, no wildcards allowed) ──
    { "pattern": "wristnerd.xyz", "custom_domain": true },
    { "pattern": "arabictools.wristnerd.xyz", "custom_domain": true },
    { "pattern": "crypto.wristnerd.xyz", "custom_domain": true },
    { "pattern": "cryptoranked.xyz", "custom_domain": true },
    // compareai.site (OUT-3) is intentionally absent for now: the zone has
    // pre-existing externally-managed A/CNAME records, so wrangler's
    // custom-domain provisioning fails the WHOLE deploy with API error
    // 100117 ("Hostname already has externally managed DNS records").
    // Re-add { "pattern": "compareai.site", "custom_domain": true } only
    // AFTER deleting those DNS records in the Cloudflare dashboard
    // (compareai.site zone -> DNS -> remove the A/CNAME for the apex).
    // ── To add more domains (wildcards or standalone): ──────────────
    // Option A: Cloudflare Dashboard → Workers & Pages → affilite-mix
    //           → Settings → Triggers → Add Custom Domain
    // Option B: Add a Worker Route for wildcards:
    //           → Settings → Triggers → Add Route → *.wristnerd.xyz/*
    // Option C: Add another { "pattern": "newdomain.xyz", "custom_domain": true } here
    // The middleware resolves any domain → site_id via DB lookup
  ],
  // Cron triggers — publish scheduled content, AI generation, and sitemap refresh
  //
  // A43: CRON SAFETY REQUIREMENTS:
  //   * All schedules are in UTC (no daylight-saving transitions).
  //   * Each cron handler MUST implement idempotency via a unique
  //     lock key (cf_lock/<job-name>/<date-hour> in KV).
  //   * Each cron handler MUST enforce a max runtime (e.g. 5 min) and
  //     self-abort via AbortSignal from event.waitUntil().
  //   * Failed cron runs MUST be alerted via the worker_cpu_time_alert
  //     notification policy (terraform/cloudflare/alerts.tf).
  //   * Heavy crons (AI generation, commission ingest, price scrape) are
  //     offloaded to the affilite-mix-heavy-crons worker to avoid
  //     blocking the main worker's request path.
  //
  // A43: IDEMPOTENCY + DLQ:
  //   * Each cron job writes a lock record before processing:
  //     KV.put(`cf_lock/<job>/<ts>`, JSON.stringify({started: Date.now()}), {expirationTtl: 3600})
  //   * On duplicate trigger (e.g. clock skew), the job exits early.
  //   * On failure, the error is logged and optionally re-queued to the
  //     click-tracking queue for dead-letter handling (DLQ path via
  //     the queue's dead_letter_queue binding).
  //   * A failed-run alert is sent via the http_alert_edge_error policy.
  //
  // A43: PER-TRIGGER SECRET POLICY (Production):
  //   The shared CRON_SECRET fallback is disabled in production.
  //   Each trigger MUST use its own secret (set via wrangler secret put):
  //     CRON_PUBLISH_SECRET, CRON_STRIPE_SYNC_SECRET, CRON_AI_SECRET,
  //     CRON_SITEMAP_SECRET, CRON_RETENTION_SECRET, CRON_COMMISSION_SECRET,
  //     CRON_EPC_SECRET, CRON_PRICE_SECRET, CRON_DEALS_SECRET
  //
  // SCHEDULE BREAKDOWN (all times UTC):
  // - */5 * * * *  → Every 5 minutes: Publish scheduled content
  // - 0 1 * * *    → Daily at 1 AM UTC: Stripe sync
  // - 0 3 * * *    → Daily at 3 AM UTC: Sitemap refresh
  // - 0 4 * * *    → Daily at 4 AM UTC: Data retention
  // - 0 6 * * *    → Daily at 6 AM UTC: EPC recompute
  // - 0 * * * *    → Hourly: Expire deals
  "triggers": {
    "crons": [
      "*/5 * * * *", // A43: Publish scheduled content (every 5 min UTC)
      "0 1 * * *", // A43: Stripe sync (daily 1 AM UTC)
      // A-018/A43: Heavy crons → affilite-mix-heavy-crons worker
      // "0 2 * * *", // AI content generation (daily 2 AM UTC)
      "0 3 * * *", // A43: Sitemap refresh (daily 3 AM UTC)
      "0 4 * * *", // A43: Data retention (daily 4 AM UTC)
      // A-018/A43: Heavy crons → affilite-mix-heavy-crons worker
      // "0 5 * * *", // Commission ingest (daily 5 AM UTC)
      "0 6 * * *", // A43: EPC recompute (daily 6 AM UTC)
      // A-018/A43: Heavy crons → affilite-mix-heavy-crons worker
      // "0 7 * * *", // Price scrape (daily 7 AM UTC)
      "0 * * * *", // A43: Expire deals (hourly)
      "*/15 * * * *", // Click reconcile (every 15 min)
      "0 8 * * 1", // Access review (Mon 08:00 UTC, SOC 2 CC6.1)
    ],
  },
  // FIX-02 (F-018): NODE_ENV must be "production" so the app rejects dev fallback
  // tokens and enables production-only guards. Without this, the Workers runtime
  // defaults NODE_ENV to "production" but the Next.js shim may not propagate it.
  "vars": {
    "NODE_ENV": "production",

    // FALLBACK ONLY — never the primary origin source. Production request
    // paths derive absolute URLs from the active tenant site's own domain
    // (see forgot-password and checkout routes). APP_URL is only consumed
    // where no request/tenant context exists (e.g. cron price-scrape
    // fallback) and as a local-dev override. Do not reintroduce it as the
    // canonical multi-tenant origin (phase-3 audit F3-001).
    "APP_URL": "https://wristnerd.xyz",
    "ADMIN_SESSION_STRICT": "true",
    "INTERNAL_HMAC_MIGRATION_MODE": "strict",
  },
  // Workers observability (logs, errors, metrics in CF dashboard)
  "observability": {
    "enabled": true,
  },
  // A-013: OpenTelemetry tracing — disabled by default.
  // To enable, add "otel" block back with your endpoint and token.
  // Smart placement — run the worker close to the origin (Supabase)
  "placement": {
    "mode": "smart",
  },
  // ═════════════════════════════════════════════════════════════════
  // TAIL CONSUMERS — Log Shipping / Long-Term Retention (W8)
  // ═════════════════════════════════════════════════════════════════
  // Workers Observability (above) provides dashboard logs but NO
  // long-term retention or external alerting pipeline.  A Tail Worker
  // forwards every request/log/exception event to a durable log sink
  // (e.g. Axiom, Datadog, Grafana Loki, Better Stack, S3).
  //
  // A40: Tail consumer is enabled in production to export logs to a
  // durable sink for retention and search. The log-shipper worker must
  // be deployed first (see workers/log-shipper/README.md).
  //
  // Setup (one-time):
  //   1. cd workers/log-shipper && wrangler deploy
  //   2. Verify the shipper is receiving events in the CF dashboard
  //   3. The deploy workflow auto-injects this entry on main pushes
  //
  "tail_consumers": [
    // A40: Durable observability sink — log-shipper worker forwards to
    // the configured long-term storage backend (R2 / Axiom / etc.).
    { "service": "affilite-mix-log-shipper" },
  ],
}
// BLIND SPOT FIX: Production Bindings & Secrets Truth
// ---------------------------------------------------
// The following secrets MUST be provisioned in the Cloudflare Dashboard
// or via `wrangler secret put <NAME> --env production` for production:
//
// - SUPABASE_URL: The REST API URL for the Supabase project
// - SUPABASE_SERVICE_ROLE_KEY: The service_role JWT for the Supabase project
// - JWT_SECRET: A strong 256-bit secure random string for signing admin sessions
// - STRIPE_SECRET_KEY: Restricted API key (rk_live_...) — do NOT use legacy full-access keys
// - STRIPE_WEBHOOK_SECRET: Live mode Stripe webhook signing secret (whsec_...)
// - INTERNAL_API_TOKEN: Shared secret between Cloudflare Queue and the API
// - CRON_SECRET: DEPRECATED in production (A43). Per-trigger secrets are used
//   instead (CRON_PUBLISH_SECRET, CRON_STRIPE_SYNC_SECRET, etc. — see the
//   A43 cron trigger documentation above). CRON_SECRET may still be set in
//   local dev / staging for convenience but MUST NOT be relied upon in production.
// - TURNSTILE_SECRET_KEY: Cloudflare Turnstile secret
// - APP_URL: Canonical app URL for absolute URLs (e.g. password reset links)
// - RESEND_API_KEY: Resend API key for outbound emails
// - CLOUDFLARE_ACCOUNT_ID: Required for Cloudflare AI provider
// - CLOUDFLARE_API_TOKEN: Scoped token for Cloudflare AI provider
// - SENTRY_DSN: Sentry project DSN
//
// Bindings are declared above (kv_namespaces, d1_databases, r2_buckets,
// queues, analytics_engine_datasets). Ensure these are created in the
// Cloudflare Dashboard before deploying.
