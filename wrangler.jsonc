{
  "name": "my-worker",
  "compatibility_date": "2024-01-01",
  "vars": {
    "NEXT_PUBLIC_SENTRY_DSN": "https://public@sentry.io/123456"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 2 * * *",
      "0 3 * * *"
    ]
  },
  "tail_consumers": [
    {
      "service": "tail-worker"
    }
  ],
  "observability": {
    "enabled": true
  }
}
